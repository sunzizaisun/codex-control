{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-dot-inbox",
  "main": "src/events/production.ts",
  "tsconfig": "tsconfig.events.json",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "secrets": { "required": ["EVENTS_DEVICE_KEY", "EVENTS_ADMIN_KEY", "CALLBACK_RELAY_KEY"] },
  "vars": { "EVENTS_MODE": "authenticated-events", "EVENTS_OWNER": "wearable-owner", "CALLBACK_RELAY_URL": "https://dot-callback.example.com/relay" },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "durable_objects": { "bindings": [{ "name": "EVENT_INBOXES", "class_name": "DotEventInbox" }] },
  "migrations": [{ "tag": "dot-inbox-v1", "new_sqlite_classes": ["DotEventInbox"] }]
}
