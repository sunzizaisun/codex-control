<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Agent Bridge</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CodexRelayRoom</key>
	<string>$(CODEX_RELAY_ROOM)</string>
	<key>CodexRelaySecret</key>
	<string>$(CODEX_RELAY_SECRET)</string>
	<key>CodexRelayURL</key>
	<string>$(CODEX_RELAY_URL)</string>
	<key>CodexBrowserGatewayEnabled</key>
	<string>$(CODEX_BROWSER_GATEWAY_ENABLED)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_codexrelay._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Agent Bridge advertises a secure connection to Codex Relay on your local network.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Agent Bridge can open the matching ChatGPT task or a signed-in chatgpt.com tab in Google Chrome, then send the iPhone or Apple Watch message you explicitly chose.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
